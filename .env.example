# Скопируй этот файл в .env и подставь свои значения.
# Expo подхватывает переменные с префиксом EXPO_PUBLIC_ автоматически,
# без дополнительной настройки — просто перезапусти `npx expo start`
# после изменения.

# Стартовый адрес локального solana-test-validator.
# Менять его после сборки НЕ нужно: адрес задаётся в приложении,
# Настройки -> «Локальный узел» (или команда rpc в dev-консоли).
# Здесь — только значение по умолчанию, которое вшивается в билд.
EXPO_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8899

# Показывать плавающую dev-консоль в release-сборке (по умолчанию скрыта).
# Включай только для демо, где нужно пополнять кошелёк командой add.
# Как и все EXPO_PUBLIC_*, значение вшивается в билд — менять нужно до сборки.
EXPO_PUBLIC_DEBUG_CONSOLE=0
